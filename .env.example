# --- MySQL (used by docker-compose.yml and docker-compose.dev.yml) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- Backend (docker-compose.dev.yml maps these from the MySQL vars above) ---
# DB_HOST is hardcoded to the service name "mysql" inside docker-compose.dev.yml.
# BACKEND_PORT controls the host-side port mapping (container always uses 4000).
BACKEND_PORT=4000
